## Test suite for clipboard
## Part of the Alya Language package ecosystem (https://github.com/alya-lang)

import "std/test"
import "../src/lib.alya" as pkg

# Watcher hook probe recording fired entries.
let seen_entries = []

function watch_probe(entry)
    seen_entries.push(entry)
    return 1
end

function main()
    test_suite("clipboard Test Suite")
    let r = runner_new()

    # ═══════════════════════════════════════════════════════════
    # 1. Native FFI Smoke Test & Enumerations
    # ═══════════════════════════════════════════════════════════
    runner_assert_eq(r, pkg::native_add(10, 32), 42, "pkg::native_add executes bundled C code")
    runner_assert_eq(r, pkg::native_text_limit() > 0, 1, "native text limit is positive")

    runner_assert_eq(r, pkg::ClipboardFormat.Text, 0, "ClipboardFormat.Text == 0")
    runner_assert_eq(r, pkg::ClipboardFormat.Html, 1, "ClipboardFormat.Html == 1")
    runner_assert_eq(r, pkg::ClipboardFormat.Image, 2, "ClipboardFormat.Image == 2")
    runner_assert_eq(r, pkg::ClipboardFormat.Audio, 3, "ClipboardFormat.Audio == 3")
    runner_assert_eq(r, pkg::ClipboardFormat.Files, 4, "ClipboardFormat.Files == 4")
    runner_assert_eq(r, pkg::ClipboardFormat.Custom, 5, "ClipboardFormat.Custom == 5")

    runner_assert_eq(r, pkg::ClipboardBackend.Memory, 0, "ClipboardBackend.Memory == 0")
    runner_assert_eq(r, pkg::ClipboardBackend.Native, 1, "ClipboardBackend.Native == 1")
    runner_assert_eq(r, pkg::ClipboardBackend.Auto, 2, "ClipboardBackend.Auto == 2")

    # ═══════════════════════════════════════════════════════════
    # 2. Text Payloads & Codec Helpers
    # ═══════════════════════════════════════════════════════════
    let cb = pkg::new_clipboard()
    runner_assert_eq(r, cb.is_empty(), 1, "fresh clipboard is empty")
    runner_assert_eq(r, cb.copy_text("hello clipboard"), 1, "copy_text returns 1")
    runner_assert_str_eq(r, cb.paste_text(), "hello clipboard", "paste_text round-trips")
    runner_assert_eq(r, cb.has_text(), 1, "has_text reports stored text")
    runner_assert_eq(r, cb.has("text"), 1, "has finds the text slot")

    cb.copy_text("a\r\nb\rc")
    runner_assert_str_eq(r, cb.paste_text(), "a\nb\nc", "line endings normalize to LF")
    runner_assert_eq(r, pkg::text_line_count("a\nb\nc"), 3, "line count counts separators")
    runner_assert_eq(r, pkg::is_blank_text("   "), 1, "blank text detected")
    runner_assert_eq(r, pkg::is_blank_text(" x "), 0, "non-blank text detected")
    runner_assert_str_eq(r, pkg::text_preview("abcdef", 3), "abc...", "preview truncates with ellipsis")

    # ═══════════════════════════════════════════════════════════
    # 3. HTML Payloads
    # ═══════════════════════════════════════════════════════════
    runner_assert_eq(r, cb.copy_html("<b>Hi</b>", "Hi"), 1, "copy_html returns 1")
    let payload = cb.paste_html()
    runner_assert_str_eq(r, payload["html"], "<b>Hi</b>", "html markup round-trips")
    runner_assert_str_eq(r, payload["plain"], "Hi", "plain alternative round-trips")
    runner_assert_str_eq(r, cb.paste_html_text(), "Hi", "paste_html_text returns alternative")
    runner_assert_eq(r, cb.has_html(), 1, "has_html reports stored markup")

    runner_assert_eq(r, cb.copy_html("<p>Hey</p>"), 1, "copy_html without plain returns 1")
    runner_assert_str_eq(r, cb.paste_html_text(), " Hey ", "plain falls back to stripped markup")
    runner_assert_str_eq(r, pkg::html_escape("<a>&"), "&lt;a&gt;&amp;", "html_escape escapes markup")
    runner_assert_str_eq(r, pkg::html_strip("<b>x</b>"), " x ", "html_strip removes tags")
    runner_assert_eq(r, pkg::html_markup_valid("<b>x</b>"), 1, "html_valid accepts tags")
    runner_assert_eq(r, pkg::html_markup_valid("plain"), 0, "html_valid rejects plain text")

    # ═══════════════════════════════════════════════════════════
    # 4. Image Payloads
    # ═══════════════════════════════════════════════════════════
    let img = pkg::blank_image(4, 2, 3, 7)
    runner_assert_eq(r, img.image_valid(), 1, "blank_image is valid")
    runner_assert_eq(r, img.pixels(), 8, "pixels reports width * height")
    runner_assert_eq(r, cb.copy_image(img), 1, "copy_image returns 1")
    runner_assert_eq(r, cb.has_image(), 1, "has_image reports stored image")
    let back_img = cb.paste_image()
    runner_assert_eq(r, back_img.width, 4, "image width round-trips")
    runner_assert_eq(r, len(back_img.data), 24, "image bytes round-trip")

    let gray = pkg::image_grayscale(img)
    runner_assert_eq(r, gray.image_valid(), 1, "grayscale output is valid")
    runner_assert_eq(r, gray.data[0], gray.data[1], "grayscale channels match")
    let thumb = pkg::image_thumbnail(pkg::blank_image(64, 32, 3, 9), 16)
    runner_assert_eq(r, thumb.width, 16, "thumbnail fits max side")
    runner_assert_eq(r, thumb.height, 8, "thumbnail keeps aspect ratio")

    let bad_img = pkg::make_image(2, 2, 3, [1, 2, 3])
    runner_assert_eq(r, bad_img.image_valid(), 0, "short byte array is invalid")
    runner_assert_eq(r, cb.copy_image(bad_img), 0, "copy_image rejects invalid payload")

    # ═══════════════════════════════════════════════════════════
    # 5. Audio Payloads (Ses)
    # ═══════════════════════════════════════════════════════════
    let tone = pkg::silent_audio(100, 8000, 1, 8)
    runner_assert_eq(r, tone.audio_valid(), 1, "silent_audio is valid")
    runner_assert_eq(r, tone.duration_ms(), 100, "silent duration matches request")
    runner_assert_eq(r, cb.copy_audio(tone), 1, "copy_audio returns 1")
    runner_assert_eq(r, cb.has_audio(), 1, "has_audio reports stored audio")
    let back_aud = cb.paste_audio()
    runner_assert_eq(r, back_aud.sample_rate, 8000, "sample rate round-trips")
    runner_assert_eq(r, pkg::audio_frame_count(back_aud), 800, "frame count matches 100ms at 8kHz")

    let beep = pkg::beep_audio(440, 50, 8000, 60)
    runner_assert_eq(r, beep.audio_valid(), 1, "beep_audio is valid")
    runner_assert_eq(r, beep.duration_ms(), 50, "beep duration matches request")

    let bad_aud = pkg::make_audio(8000, 1, 16, [1, 2, 3])
    runner_assert_eq(r, bad_aud.audio_valid(), 0, "odd 16-bit array is invalid")
    runner_assert_eq(r, cb.copy_audio(bad_aud), 0, "copy_audio rejects invalid payload")

    # ═══════════════════════════════════════════════════════════
    # 6. File Lists & Custom Formats
    # ═══════════════════════════════════════════════════════════
    runner_assert_eq(r, cb.copy_files(["/tmp/a.txt", "", "/tmp/b.txt", "/tmp/a.txt", null]), 1, "copy_files returns 1")
    let files = cb.paste_files()
    runner_assert_eq(r, len(files), 2, "files normalize blanks and duplicates")
    runner_assert_str_eq(r, files[0], "/tmp/a.txt", "first path preserved")
    runner_assert_str_eq(r, files[1], "/tmp/b.txt", "second path preserved")
    runner_assert_eq(r, cb.has_files(), 1, "has_files reports stored list")
    runner_assert_eq(r, cb.copy_files([]), 0, "copy_files rejects empty list")

    runner_assert_eq(r, cb.copy_files(["/tmp/solo.txt"]), 1, "shorter rewrite returns 1")
    let solo = cb.paste_files()
    runner_assert_eq(r, len(solo), 1, "shorter rewrite drops stale entries")
    runner_assert_str_eq(r, solo[0], "/tmp/solo.txt", "rewritten path preserved")

    runner_assert_eq(r, cb.set_custom("theme", "dark", "text/plain"), 1, "set_custom returns 1")
    runner_assert_str_eq(r, cb.get_custom("theme"), "dark", "custom payload round-trips")
    runner_assert_eq(r, cb.has_custom("theme"), 1, "has_custom reports stored name")
    runner_assert_eq(r, cb.set_custom("", "x"), 0, "set_custom rejects blank names")

    let fmt_names = cb.formats()
    let leaked = 0
    for f in fmt_names
        if f == "html_text" or f == "files:0"
            leaked = 1
        end
    end
    runner_assert_eq(r, leaked, 0, "internal html/file slots stay hidden")

    # ═══════════════════════════════════════════════════════════
    # 7. Formats, Metadata, Stats & Clearing
    # ═══════════════════════════════════════════════════════════
    let names = cb.formats()
    runner_assert_eq(r, len(names) > 0, 1, "formats list is non-empty")
    runner_assert_eq(r, cb.has("image"), 1, "has finds the image slot")
    let meta = cb.meta("text")
    runner_assert_eq(r, meta.format, pkg::ClipboardFormat.Text, "metadata entry carries the text format")
    runner_assert_str_eq(r, meta.mime, "text/plain", "text metadata carries MIME label")

    let stats = cb.stats()
    runner_assert_eq(r, stats.writes > 0, 1, "stats count writes")
    runner_assert_eq(r, stats.reads > 0, 1, "stats count reads")
    runner_assert_eq(r, stats.seq > 0, 1, "stats expose sequence")
    runner_assert_str_eq(r, stats.stats_summary()[..11], "[Clipboard]", "stats summary has prefix")

    runner_assert_eq(r, cb.clear_format("text"), 1, "clear_format removes the slot")
    runner_assert_eq(r, cb.has_text(), 0, "cleared text is gone")
    let dropped = cb.clear()
    runner_assert_eq(r, dropped > 0, 1, "clear removes remaining formats")
    runner_assert_eq(r, cb.is_empty(), 1, "clipboard is empty after clear")

    # ═══════════════════════════════════════════════════════════
    # 8. History Log
    # ═══════════════════════════════════════════════════════════
    let hb = pkg::new_clipboard("memory", 3)
    hb.copy_text("one")
    hb.copy_text("two")
    hb.copy_text("three")
    hb.copy_text("four")
    runner_assert_eq(r, hb.history_len(), 3, "history honors the retention cap")
    runner_assert_str_eq(r, hb.history_last().preview, "four", "last entry is the newest write")
    runner_assert_str_eq(r, hb.history_get(0).preview, "two", "oldest retained entry is correct")
    runner_assert_str_eq(r, hb.history_get(-1).preview, "four", "negative index counts from the end")
    runner_assert_eq(r, len(hb.history_by_format("text")), 3, "history filters by format")
    runner_assert_eq(r, hb.history_clear(), 3, "history_clear drops retained entries")
    runner_assert_eq(r, hb.history_len(), 0, "history is empty after clear")

    # ═══════════════════════════════════════════════════════════
    # 9. Change Watcher
    # ═══════════════════════════════════════════════════════════
    let wb = pkg::new_clipboard()
    wb.on_change(watch_probe)
    runner_assert_eq(r, wb.watch_changed(), 0, "no change before any write")
    wb.copy_text("watched")
    runner_assert_eq(r, wb.watch_changed(), 1, "write is observed without polling")
    runner_assert_eq(r, wb.watch_poll(), 1, "poll reports the change")
    runner_assert_eq(r, len(seen_entries), 1, "hook fired exactly once")
    runner_assert_str_eq(r, seen_entries[0].preview, "watched", "hook received the latest entry")
    runner_assert_eq(r, wb.watch_poll(), 0, "second poll is quiet")
    wb.watch_stop()
    wb.copy_text("unwatched")
    runner_assert_eq(r, wb.watch_poll(), 1, "poll marker still advances after stop")
    runner_assert_eq(r, len(seen_entries), 1, "stopped watcher fires no hook")

    # ═══════════════════════════════════════════════════════════
    # 10. Native Bridge (best-effort, headless-safe)
    # ═══════════════════════════════════════════════════════════
    let avail = pkg::native_available()
    runner_assert_eq(r, avail == 0 or avail == 1, 1, "native_available reports 0 or 1")
    runner_assert_eq(r, pkg::system_copy_text(null), 0, "system_copy_text rejects null")
    let probe = pkg::new_clipboard("auto")
    runner_assert_eq(r, pkg::auto_copy_text(probe, "auto-mirror"), 1, "auto_copy_text always stores locally")
    runner_assert_str_eq(r, pkg::auto_paste_text(probe), "auto-mirror", "auto_paste_text falls back to memory")

    # ═══════════════════════════════════════════════════════════
    # 11. Overview Methods, Functional Wrappers & Extras
    # ═══════════════════════════════════════════════════════════
    runner_assert_eq(r, len(cb.clipboard_summary()) > 0, 1, "summary renders non-empty overview")
    runner_assert_eq(r, cb.clipboard_valid(), 1, "clipboard reports valid")
    runner_assert_eq(r, len(cb.clipboard_describe()) > 0, 1, "describe renders details")

    let fb = pkg::new_clipboard()
    runner_assert_eq(r, pkg::clipboard_copy_text(fb, "fn-style"), 1, "functional copy_text works")
    runner_assert_str_eq(r, pkg::clipboard_paste_text(fb), "fn-style", "functional paste_text works")
    runner_assert_eq(r, len(pkg::clipboard_formats(fb)) > 0, 1, "functional formats works")
    runner_assert_eq(r, pkg::clipboard_stats(fb).writes > 0, 1, "functional stats works")

    @cfg(feature = "extras")
    let grad = pkg::gradient_image(8, 8)
    @cfg(feature = "extras")
    runner_assert_eq(r, grad.image_valid(), 1, "gradient_image is valid")
    @cfg(feature = "extras")
    let eb = pkg::new_clipboard()
    @cfg(feature = "extras")
    runner_assert_eq(r, pkg::batch_copy(eb, "t", "<p>t</p>", grad, null, ["/tmp/x"]), 4, "batch_copy writes four formats")
    @cfg(feature = "extras")
    let target = pkg::new_clipboard()
    @cfg(feature = "extras")
    runner_assert_eq(r, pkg::sync_from(target, eb) >= 4, 1, "sync_from mirrors formats")
    @cfg(feature = "extras")
    runner_assert_str_eq(r, target.paste_text(), "t", "synced text round-trips")
    @cfg(feature = "extras")
    let dump = pkg::snapshot_dump(eb)
    @cfg(feature = "extras")
    let restored = pkg::new_clipboard()
    @cfg(feature = "extras")
    runner_assert_eq(r, pkg::snapshot_restore(restored, dump) >= 4, 1, "snapshot round-trips formats")
    @cfg(feature = "extras")
    runner_assert_str_eq(r, restored.paste_text(), "t", "restored text round-trips")
    @cfg(feature = "extras")
    runner_assert_str_eq(r, restored.paste_html_text(), " t ", "restored html plain round-trips")

    let failed = runner_summary(r)
    if failed > 0
        exit(1)
    end
end

main()
