## Example usage and walkthrough for clipboard
## Part of the Alya Language package ecosystem (https://github.com/alya-lang)

import "../src/lib.alya" as pkg

function main()
    say "=== clipboard Package Showcase ==="
    say ""

    # ───────────────────────────────────────────────────────────
    # 1. Text & HTML
    # ───────────────────────────────────────────────────────────
    say "--- 1. Text & HTML ---"
    let cb = pkg::new_clipboard()
    cb.copy_text("hello clipboard")
    say "Text:  " + cb.paste_text()
    cb.copy_html("<b>Hi</b>", "Hi")
    say "HTML:  " + cb.paste_html()["html"]
    say "Plain: " + cb.paste_html_text()
    say ""

    # ───────────────────────────────────────────────────────────
    # 2. Image (Gorsel)
    # ───────────────────────────────────────────────────────────
    say "--- 2. Image ---"
    let img = pkg::blank_image(8, 8, 3, 200)
    cb.copy_image(img)
    say "Stored: " + pkg::format_image(cb.paste_image())
    say "Gray:   " + pkg::image_grayscale(img).image_describe()
    say "Thumb:  " + pkg::image_thumbnail(img, 4).image_summary()
    say ""

    # ───────────────────────────────────────────────────────────
    # 3. Audio (Ses)
    # ───────────────────────────────────────────────────────────
    say "--- 3. Audio ---"
    let beep = pkg::beep_audio(440, 100, 8000, 60)
    cb.copy_audio(beep)
    say "Stored: " + pkg::format_audio(cb.paste_audio())
    say ""

    # ───────────────────────────────────────────────────────────
    # 4. Files, Custom Formats & Stats
    # ───────────────────────────────────────────────────────────
    say "--- 4. Files, Custom & Stats ---"
    cb.copy_files(["/tmp/report.txt", "/tmp/photo.png"])
    say "Files: " + pkg::format_files(cb.paste_files())
    cb.set_custom("theme", "dark", "text/plain")
    say "Custom theme: " + cb.get_custom("theme")
    say "Formats: " + pkg::format_formats(cb)
    say "Stats:   " + cb.stats().stats_summary()
    say ""

    # ───────────────────────────────────────────────────────────
    # 5. History & Watcher
    # ───────────────────────────────────────────────────────────
    say "--- 5. History & Watcher ---"
    say "History entries: " + str(cb.history_len())
    say "Last entry:      " + cb.history_last().preview
    cb.on_change(null)
    cb.copy_text("watched write")
    say "Changed since watch: " + str(cb.watch_changed())
    say "Poll result:         " + str(cb.watch_poll())
    say ""

    # ───────────────────────────────────────────────────────────
    # 6. Native Bridge & Extras
    # ───────────────────────────────────────────────────────────
    say "--- 6. Native Bridge & Extras ---"
    say "Native available: " + str(pkg::native_available())
    say "FFI check (6+7):  " + str(pkg::native_add(6, 7))
    @cfg(feature = "extras")
    say "Gradient: " + pkg::gradient_image(4, 4).image_summary()
    @cfg(not(feature = "extras"))
    say "Gradient: (disabled — rebuild with --features extras)"
    say ""

    say ""
    say "Done!"
end

main()
