## Benchmark suite for clipboard
## Part of the Alya Language package ecosystem (https://github.com/alya-lang)

import "std/test"
import "../src/lib.alya" as pkg

function main()
    let runner = bench_runner("clipboard Micro-Benchmarks")

    # Bench 1: text copy/paste round-trip — 20k iterations
    let text_cb = pkg::new_clipboard()
    bench_start(runner, 20000)
    let i = 0
    while i < 20000
        text_cb.copy_text("benchmark payload")
        text_cb.paste_text()
        i += 1
    end
    bench_stop(runner, "copy/paste text 20k round-trips")

    # Bench 2: small image copy — 2k iterations of 8x8 RGB
    let small = pkg::blank_image(8, 8, 3, 128)
    let img_cb = pkg::new_clipboard()
    bench_start(runner, 2000)
    let j = 0
    while j < 2000
        img_cb.copy_image(small)
        j += 1
    end
    bench_stop(runner, "copy_image 8x8 RGB 2k writes")

    # Bench 3: grayscale conversion — 500 iterations of 16x16 RGB
    let gray_src = pkg::blank_image(16, 16, 3, 90)
    bench_start(runner, 500)
    let k = 0
    while k < 500
        pkg::image_grayscale(gray_src)
        k += 1
    end
    bench_stop(runner, "image_grayscale 16x16 500 calls")

    # Bench 4: file list copy — 10k iterations
    let file_cb = pkg::new_clipboard()
    bench_start(runner, 10000)
    let m = 0
    while m < 10000
        file_cb.copy_files(["/tmp/a.txt", "/tmp/b.txt"])
        m += 1
    end
    bench_stop(runner, "copy_files 2-item list 10k writes")

    # Bench 5: history-tracked writes — 5k iterations (uncapped history)
    let hist_cb = pkg::new_clipboard("memory", 0)
    bench_start(runner, 5000)
    let s = 0
    while s < 5000
        hist_cb.copy_text("history payload")
        s += 1
    end
    bench_stop(runner, "history-tracked writes 5k calls")

    # Bench 6: stats snapshot — 50k iterations
    bench_start(runner, 50000)
    let c = 0
    while c < 50000
        text_cb.stats()
        c += 1
    end
    bench_stop(runner, "stats() snapshot 50k calls")

    bench_summary(runner)
end

main()
