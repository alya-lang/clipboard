## clipboard Library Facade
##
## Part of the Alya Language package ecosystem (https://github.com/alya-lang).
## Primary public entry point for the clipboard package: constructors,
## stateful Clipboard methods (text, HTML, image, audio, files, custom),
## history and watcher helpers, and native OS bridge re-exports.

import "./types.alya"
import "./ffi.alya"
import "./core/codec.alya"
import "./core/store.alya"
import "./core/history.alya"
import "./core/watcher.alya"
import "./core/formatter.alya"
import "./core/system.alya"
import "./core/extras.alya"

# ───────────────────────────────────────────────────────────────
# Constructors
# ───────────────────────────────────────────────────────────────

## Creates an empty clipboard container.
##
## ### Parameters
## - `backend`: Backend selector (`"memory"`, `"native"`, `"auto"`). Defaults to `"memory"`.
## - `max_history`: Retained history cap (`<= 0` unbounded). Defaults to `32`.
##
## ### Returns
## Empty, initialized `Clipboard` instance.
##
## ### Examples
## ```alya
## let cb = new_clipboard()
## cb.copy_text("hello")
## ```
pub function new_clipboard(backend = "memory", max_history: int = 32) -> Clipboard
    return clipboard_new(backend, max_history)
end

## Creates a clipboard container from a `ClipboardConfig` instance.
pub function clipboard_from_config(cfg: ClipboardConfig) -> Clipboard
    return clipboard_with_config(cfg)
end

# ───────────────────────────────────────────────────────────────
# Native C FFI Smoke Test
# ───────────────────────────────────────────────────────────────

## Native C FFI helper proving the bundled engine links correctly.
pub function native_add(a: int = 0, b: int = 0) -> int
    return alya_clipboard_add(a, b)
end

# ───────────────────────────────────────────────────────────────
# Stateful Clipboard Methods: Text / HTML
# ───────────────────────────────────────────────────────────────

## Stores text, replacing any previous text payload. Returns 1.
pub function Clipboard.copy_text(self: Clipboard, text) -> int
    return store_copy_text(self, text)
end

## Returns the stored text, or null when no text is present.
pub function Clipboard.paste_text(self: Clipboard)
    return store_paste_text(self)
end

## Returns 1 when a non-blank text payload is present, 0 otherwise.
pub function Clipboard.has_text(self: Clipboard) -> int
    return store_has_text(self)
end

## Stores HTML markup with an optional plain-text alternative. Returns 1.
pub function Clipboard.copy_html(self: Clipboard, html, plain = null) -> int
    return store_copy_html(self, html, plain)
end

## Returns the stored HTML payload map (`html`/`plain`), or null when absent.
pub function Clipboard.paste_html(self: Clipboard)
    return store_paste_html(self)
end

## Returns the plain-text alternative of the stored HTML, or null when absent.
pub function Clipboard.paste_html_text(self: Clipboard)
    return store_paste_html_text(self)
end

## Returns 1 when an HTML payload is present, 0 otherwise.
pub function Clipboard.has_html(self: Clipboard) -> int
    return store_has_html(self)
end

# ───────────────────────────────────────────────────────────────
# Stateful Clipboard Methods: Image / Audio
# ───────────────────────────────────────────────────────────────

## Stores an image payload. Returns 1 on success, 0 when invalid.
pub function Clipboard.copy_image(self: Clipboard, img: ClipboardImage) -> int
    return store_copy_image(self, img)
end

## Returns the stored `ClipboardImage`, or null when absent.
pub function Clipboard.paste_image(self: Clipboard)
    return store_paste_image(self)
end

## Returns 1 when a valid image payload is present, 0 otherwise.
pub function Clipboard.has_image(self: Clipboard) -> int
    return store_has_image(self)
end

## Stores an audio payload. Returns 1 on success, 0 when invalid.
pub function Clipboard.copy_audio(self: Clipboard, aud: ClipboardAudio) -> int
    return store_copy_audio(self, aud)
end

## Returns the stored `ClipboardAudio`, or null when absent.
pub function Clipboard.paste_audio(self: Clipboard)
    return store_paste_audio(self)
end

## Returns 1 when a valid audio payload is present, 0 otherwise.
pub function Clipboard.has_audio(self: Clipboard) -> int
    return store_has_audio(self)
end

# ───────────────────────────────────────────────────────────────
# Stateful Clipboard Methods: Files / Custom / Lifecycle
# ───────────────────────────────────────────────────────────────

## Stores a file path list. Returns 1 on success, 0 when the list is empty.
pub function Clipboard.copy_files(self: Clipboard, paths) -> int
    return store_copy_files(self, paths)
end

## Returns the stored file path array, or null when absent.
pub function Clipboard.paste_files(self: Clipboard)
    return store_paste_files(self)
end

## Returns 1 when a non-empty file list is present, 0 otherwise.
pub function Clipboard.has_files(self: Clipboard) -> int
    return store_has_files(self)
end

## Stores an application-defined payload under `custom:<name>`. Returns 1.
pub function Clipboard.set_custom(self: Clipboard, name, value, mime: string = "application/octet-stream") -> int
    return store_set_custom(self, name, value, mime)
end

## Returns a custom payload by name, or null when absent.
pub function Clipboard.get_custom(self: Clipboard, name)
    return store_get_custom(self, name)
end

## Returns 1 when the named custom payload exists, 0 otherwise.
pub function Clipboard.has_custom(self: Clipboard, name) -> int
    return store_has_custom(self, name)
end

## Clears one format slot. Returns 1 when a payload was removed.
pub function Clipboard.clear_format(self: Clipboard, format_name) -> int
    return store_clear_format(self, format_name)
end

## Clears every format slot. Returns the number of removed formats.
pub function Clipboard.clear(self: Clipboard) -> int
    return store_clear_all(self)
end

## Returns an independent copy of the present format-name list.
pub function Clipboard.formats(self: Clipboard) -> array
    return store_formats(self)
end

## Returns 1 when the named format slot is present, 0 otherwise.
pub function Clipboard.has(self: Clipboard, format_name) -> int
    return store_has(self, format_name)
end

## Returns 1 when no payload is stored, 0 otherwise.
pub function Clipboard.is_empty(self: Clipboard) -> int
    return store_is_empty(self)
end

## Returns the metadata entry for a format slot, or null when absent.
pub function Clipboard.meta(self: Clipboard, format_name)
    return store_meta(self, format_name)
end

## Builds a `ClipboardStats` snapshot of this container.
pub function Clipboard.stats(self: Clipboard) -> ClipboardStats
    return store_stats(self)
end

## Returns a one-line overview of this container.
pub function Clipboard.clipboard_summary(self: Clipboard) -> string
    return format_clipboard(self)
end

## Returns a detailed description of this container.
pub function Clipboard.clipboard_describe(self: Clipboard) -> string
    return "{self.clipboard_summary()}, updated_at={self.updated_at}"
end

## Returns 1 (a constructed clipboard is always usable).
pub function Clipboard.clipboard_valid(self: Clipboard) -> int
    return 1
end

# ───────────────────────────────────────────────────────────────
# Stateful Clipboard Methods: History
# ───────────────────────────────────────────────────────────────

## Returns the number of retained history entries.
pub function Clipboard.history_len(self: Clipboard) -> int
    return hist_len(self)
end

## Returns an independent copy of the history log (oldest first).
pub function Clipboard.history_list(self: Clipboard) -> array
    return hist_list(self)
end

## Returns the entry at `index` (negative counts from the end), or null.
pub function Clipboard.history_get(self: Clipboard, index: int)
    return hist_get(self, index)
end

## Returns the most recent entry, or null when history is empty.
pub function Clipboard.history_last(self: Clipboard)
    return hist_last(self)
end

## Returns all entries written for `format` (enum value or slot name).
pub function Clipboard.history_by_format(self: Clipboard, format) -> array
    return hist_by_format(self, format)
end

## Updates the retention cap, trimming excess entries oldest-first.
pub function Clipboard.history_set_cap(self: Clipboard, cap: int)
    hist_set_cap(self, cap)
end

## Discards the retained history log. Returns the dropped entry count.
pub function Clipboard.history_clear(self: Clipboard) -> int
    return hist_clear(self)
end

# ───────────────────────────────────────────────────────────────
# Stateful Clipboard Methods: Watcher
# ───────────────────────────────────────────────────────────────

## Registers a change hook fired with the latest entry on every poll hit.
pub function Clipboard.on_change(self: Clipboard, hook)
    watcher_on_change(self, hook)
end

## Stops change notifications and clears the registered hook.
pub function Clipboard.watch_stop(self: Clipboard)
    watcher_stop(self)
end

## Returns 1 when writes happened since the last poll, 0 otherwise.
pub function Clipboard.watch_changed(self: Clipboard) -> int
    return watcher_changed(self)
end

## Polls once, firing the hook when changed. Returns 1 on change, else 0.
pub function Clipboard.watch_poll(self: Clipboard) -> int
    return watcher_poll(self)
end

# ───────────────────────────────────────────────────────────────
# Functional Wrappers (explicit-instance style)
# ───────────────────────────────────────────────────────────────

## Functional `copy_text` operating on an explicit clipboard instance.
pub function clipboard_copy_text(cb: Clipboard, text) -> int
    return store_copy_text(cb, text)
end

## Functional `paste_text` operating on an explicit clipboard instance.
pub function clipboard_paste_text(cb: Clipboard)
    return store_paste_text(cb)
end

## Functional `copy_html` operating on an explicit clipboard instance.
pub function clipboard_copy_html(cb: Clipboard, html, plain = null) -> int
    return store_copy_html(cb, html, plain)
end

## Functional `copy_image` operating on an explicit clipboard instance.
pub function clipboard_copy_image(cb: Clipboard, img: ClipboardImage) -> int
    return store_copy_image(cb, img)
end

## Functional `paste_image` operating on an explicit clipboard instance.
pub function clipboard_paste_image(cb: Clipboard)
    return store_paste_image(cb)
end

## Functional `copy_audio` operating on an explicit clipboard instance.
pub function clipboard_copy_audio(cb: Clipboard, aud: ClipboardAudio) -> int
    return store_copy_audio(cb, aud)
end

## Functional `copy_files` operating on an explicit clipboard instance.
pub function clipboard_copy_files(cb: Clipboard, paths) -> int
    return store_copy_files(cb, paths)
end

## Functional `clear` operating on an explicit clipboard instance.
pub function clipboard_clear(cb: Clipboard) -> int
    return store_clear_all(cb)
end

## Functional `formats` operating on an explicit clipboard instance.
pub function clipboard_formats(cb: Clipboard) -> array
    return store_formats(cb)
end

## Functional `stats` operating on an explicit clipboard instance.
pub function clipboard_stats(cb: Clipboard) -> ClipboardStats
    return store_stats(cb)
end
