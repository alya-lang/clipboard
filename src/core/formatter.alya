## clipboard Formatting Engine
##
## Part of the Alya Language package ecosystem (https://github.com/alya-lang).
## Human-readable renderers for entries, statistics, payloads, and the
## clipboard container overview.

import "../types.alya"
import "./codec.alya"

# ───────────────────────────────────────────────────────────────
# Public Formatting Functions
# ───────────────────────────────────────────────────────────────

## Formats a `ClipboardEntry` into a one-line status string.
pub function format_entry(entry: ClipboardEntry) -> string
    return entry.entry_summary()
end

## Formats a `ClipboardStats` snapshot into an overview string.
pub function format_stats(stats: ClipboardStats) -> string
    return stats.stats_summary()
end

## Formats an image payload into a one-line info string.
pub function format_image(img: ClipboardImage) -> string
    return img.image_describe()
end

## Formats an audio payload into a one-line info string.
pub function format_audio(aud: ClipboardAudio) -> string
    return aud.audio_describe()
end

## Formats the present format-name list as a comma string (`"(empty)"` when none).
pub function format_formats(cb: Clipboard) -> string
    if len(cb.formats) == 0
        return "(empty)"
    end
    let out = ""
    let i = 0
    while i < len(cb.formats)
        if i > 0
            out += ", "
        end
        out += cb.formats[i]
        i += 1
    end
    return out
end

## Formats a clipboard container overview (backend, seq, formats, counters).
pub function format_clipboard(cb: Clipboard) -> string
    return "[Clipboard:{cb.backend}] seq={cb.seq}, formats=[{format_formats(cb)}], writes={cb.writes}, reads={cb.reads}, history={len(cb.history)}"
end

## Formats a file list as indexed lines (`"(no files)"` when empty).
pub function format_files(paths) -> string
    let clean = files_normalize(paths)
    if len(clean) == 0
        return "(no files)"
    end
    let out = ""
    let i = 0
    while i < len(clean)
        out += "[{i}] {clean[i]}\n"
        i += 1
    end
    return out
end
