## clipboard Types & Data Structures
##
## Part of the Alya Language package ecosystem (https://github.com/alya-lang).
## Defines clipboard formats, image/audio payloads, history entries, the
## stateful Clipboard container, and statistics for text, HTML, image,
## audio, file-list, and custom-format clipboard workflows.

# ───────────────────────────────────────────────────────────────
# Enumerations
# ───────────────────────────────────────────────────────────────

## Clipboard payload formats supported by the in-memory backend.
##
## - `Text` raw unicode text (`"text"`).
## - `Html` rich-text markup with an optional plain-text fallback (`"html"`).
## - `Image` raw RGB/RGBA pixel bytes with dimensions (`"image"`).
## - `Audio` raw PCM sample bytes with format metadata (`"audio"`).
## - `Files` list of file paths (`"files"`).
## - `Custom` application-defined payload under a custom name (`"custom:<name>"`).
pub enum ClipboardFormat
    Text = 0,
    Html = 1,
    Image = 2,
    Audio = 3,
    Files = 4,
    Custom = 5
end

## Backend selection for clipboard synchronization.
##
## - `Memory` in-memory backend only (deterministic, always available).
## - `Native` OS clipboard only (best-effort, headless-safe no-op when absent).
## - `Auto` mirror to the OS clipboard when available, always keep memory copy.
pub enum ClipboardBackend
    Memory = 0,
    Native = 1,
    Auto = 2
end

# ───────────────────────────────────────────────────────────────
# Data Models (Structs)
# ───────────────────────────────────────────────────────────────

## Raw image payload with explicit dimensions and channel count.
##
## ### Fields
## - `width`: Image width in pixels (`> 0` when valid).
## - `height`: Image height in pixels (`> 0` when valid).
## - `channels`: Samples per pixel (`3` = RGB, `4` = RGBA).
## - `data`: Flat row-major byte array (`width * height * channels` items, `0-255`).
pub struct ClipboardImage
    width: int,
    height: int,
    channels: int,
    data: array
end

## Raw PCM audio payload with explicit format metadata.
##
## ### Fields
## - `sample_rate`: Samples per second per channel (e.g. `8000`, `44100`).
## - `channels`: Channel count (`1` = mono, `2` = stereo).
## - `bits`: Bits per sample (`8` or `16`, stored as one or two bytes).
## - `data`: Flat little-endian sample byte array.
pub struct ClipboardAudio
    sample_rate: int,
    channels: int,
    bits: int,
    data: array
end

## Point-in-time record of a single clipboard write.
##
## ### Fields
## - `format`: `ClipboardFormat` variant integer.
## - `mime`: MIME label for the payload (e.g. `"text/plain"`, `"image/rgba"`).
## - `seq`: Monotonic clipboard sequence number at write time.
## - `created_at`: Millisecond epoch (`clock_ms()` base) of the write.
## - `size`: Payload size in bytes/items (format-dependent).
## - `preview`: Short human-readable preview (truncated, never raw binary).
pub struct ClipboardEntry
    format: int,
    mime: string,
    seq: int,
    created_at: int,
    size: int,
    preview: string
end

## Construction options for a Clipboard instance.
##
## ### Fields
## - `backend`: Backend selector string (`"memory"`, `"native"`, `"auto"`).
## - `max_history`: Maximum retained history entries (`<= 0` means unbounded).
## - `native_fallback`: Mirror writes to the OS clipboard when `1` and available.
pub struct ClipboardConfig
    backend: string,
    max_history: int,
    native_fallback: int
end

## Stateful clipboard container with payloads, history, and watcher state.
##
## NOTE: User payloads live directly in the `store` map (maps handle mixed
## `any` values correctly); only typed metadata lives in struct fields and
## the parallel `meta` map of `ClipboardEntry` records.
##
## ### Fields
## - `store`: Internal format name -> payload map (text/html/image/audio/files/custom).
## - `meta`: Internal format name -> `ClipboardEntry` metadata map.
## - `formats`: Ordered list of present format names (front = oldest write).
## - `seq`: Monotonic sequence bumped on every mutation.
## - `writes`: Lifetime successful write operations.
## - `reads`: Lifetime successful read operations.
## - `clears`: Lifetime clear operations.
## - `updated_at`: Millisecond epoch of the last mutation.
## - `backend`: Active backend selector string.
## - `max_history`: Maximum retained history entries (`<= 0` unbounded).
## - `history`: Array of `ClipboardEntry` records (oldest first).
## - `watch_seq`: Sequence number observed by the last watcher poll.
## - `watch_hook`: Change callback `fn(entry)` or null.
pub struct Clipboard
    store: map,
    meta: map,
    formats: array,
    seq: int,
    writes: int,
    reads: int,
    clears: int,
    updated_at: int,
    backend: string,
    max_history: int,
    history: array,
    watch_seq: int,
    watch_hook
end

## Point-in-time snapshot of clipboard utilization.
##
## ### Fields
## - `writes`: Lifetime successful writes.
## - `reads`: Lifetime successful reads.
## - `clears`: Lifetime clear operations.
## - `seq`: Current monotonic sequence number.
## - `formats`: Number of formats currently present.
## - `history_len`: Number of retained history entries.
## - `backend`: Active backend selector string.
pub struct ClipboardStats
    writes: int,
    reads: int,
    clears: int,
    seq: int,
    formats: int,
    history_len: int,
    backend: string
end

# ───────────────────────────────────────────────────────────────
# Private Helpers
# ───────────────────────────────────────────────────────────────

# Canonicalizes a backend selector string to memory/native/auto.
function backend_key_internal(backend) -> string
    if backend is null
        return "memory"
    end
    let key = "" + backend
    if key == "native" or key == "auto" or key == "memory"
        return key
    end
    return "memory"
end

# ───────────────────────────────────────────────────────────────
# Factory Constructors
# ───────────────────────────────────────────────────────────────

## Creates clipboard construction options with explicit settings.
##
## ### Parameters
## - `backend`: Backend selector (`"memory"`, `"native"`, `"auto"`). Defaults to `"memory"`.
## - `max_history`: Retained history cap (`<= 0` unbounded). Defaults to `32`.
## - `native_fallback`: Mirror to OS clipboard when `1`. Defaults to `1`.
##
## ### Returns
## Initialized `ClipboardConfig` instance.
pub function clipboard_config(backend = "memory", max_history: int = 32, native_fallback: int = 1) -> ClipboardConfig
    return ClipboardConfig {
        backend: backend_key_internal(backend),
        max_history: max_history,
        native_fallback: native_fallback
    }
end

## Creates an image payload with explicit dimensions and byte data.
##
## `data` must hold exactly `width * height * channels` byte items (`0-255`).
## Use `blank_image` or `gradient_image` (extras) to synthesize valid payloads.
pub function make_image(width: int, height: int, channels: int = 3, data: array = []) -> ClipboardImage
    let bytes = data
    if bytes is null
        bytes = []
    end
    return ClipboardImage {
        width: width,
        height: height,
        channels: channels,
        data: bytes
    }
end

## Creates an audio payload with explicit format metadata and sample bytes.
##
## For 16-bit audio `data` holds little-endian pairs (`len(data)` must be even).
pub function make_audio(sample_rate: int = 8000, channels: int = 1, bits: int = 8, data: array = []) -> ClipboardAudio
    let bytes = data
    if bytes is null
        bytes = []
    end
    return ClipboardAudio {
        sample_rate: sample_rate,
        channels: channels,
        bits: bits,
        data: bytes
    }
end

## Creates a history entry record for a clipboard write.
pub function make_entry(format: int = ClipboardFormat.Text, mime: string = "text/plain", seq: int = 0, created_at: int = 0, size: int = 0, preview: string = "") -> ClipboardEntry
    return ClipboardEntry {
        format: format,
        mime: mime,
        seq: seq,
        created_at: created_at,
        size: size,
        preview: preview
    }
end

## Creates an empty clipboard container with explicit settings.
pub function clipboard_new(backend = "memory", max_history: int = 32) -> Clipboard
    return Clipboard {
        store: map(),
        meta: map(),
        formats: [],
        seq: 0,
        writes: 0,
        reads: 0,
        clears: 0,
        updated_at: clock_ms(),
        backend: backend_key_internal(backend),
        max_history: max_history,
        history: [],
        watch_seq: 0,
        watch_hook: null
    }
end

## Creates a clipboard container from a `ClipboardConfig` instance.
pub function clipboard_with_config(cfg: ClipboardConfig) -> Clipboard
    return clipboard_new(cfg.backend, cfg.max_history)
end

## Builds a `ClipboardStats` snapshot record.
pub function make_stats(writes: int, reads: int, clears: int, seq: int, formats: int, history_len: int, backend: string = "memory") -> ClipboardStats
    return ClipboardStats {
        writes: writes,
        reads: reads,
        clears: clears,
        seq: seq,
        formats: formats,
        history_len: history_len,
        backend: backend
    }
end

# ───────────────────────────────────────────────────────────────
# Struct Methods: ClipboardImage
# ───────────────────────────────────────────────────────────────

## Returns 1 when dimensions, channels, and byte length are consistent.
pub function ClipboardImage.image_valid(self: ClipboardImage) -> int
    if self.width <= 0 or self.height <= 0
        return 0
    end
    if self.channels != 3 and self.channels != 4
        return 0
    end
    if len(self.data) != self.width * self.height * self.channels
        return 0
    end
    return 1
end

## Returns total pixel count (`width * height`).
pub function ClipboardImage.pixels(self: ClipboardImage) -> int
    return self.width * self.height
end

## Returns expected byte length (`width * height * channels`).
pub function ClipboardImage.byte_len(self: ClipboardImage) -> int
    return self.width * self.height * self.channels
end

## Returns one-line summary (`"WxH x channels"`, e.g. `"8x8 RGB"`).
pub function ClipboardImage.image_summary(self: ClipboardImage) -> string
    let mode = "RGB"
    if self.channels == 4
        mode = "RGBA"
    end
    return "{self.width}x{self.height} {mode}"
end

## Returns detailed description including byte length and validity.
pub function ClipboardImage.image_describe(self: ClipboardImage) -> string
    let flag = "invalid"
    if self.image_valid() == 1
        flag = "valid"
    end
    return "[Image] {self.image_summary()}, bytes={len(self.data)}, {flag}"
end

# ───────────────────────────────────────────────────────────────
# Struct Methods: ClipboardAudio
# ───────────────────────────────────────────────────────────────

## Returns 1 when rate, channels, bit depth, and byte length are consistent.
pub function ClipboardAudio.audio_valid(self: ClipboardAudio) -> int
    if self.sample_rate <= 0 or self.channels <= 0
        return 0
    end
    if self.channels > 8
        return 0
    end
    if self.bits != 8 and self.bits != 16
        return 0
    end
    if self.bits == 16 and len(self.data) % 2 != 0
        return 0
    end
    return 1
end

## Returns sample frame count (samples per channel).
pub function ClipboardAudio.frames(self: ClipboardAudio) -> int
    let bytes_per_sample = 1
    if self.bits == 16
        bytes_per_sample = 2
    end
    let stride = bytes_per_sample * self.channels
    if stride <= 0
        return 0
    end
    return len(self.data) / stride
end

## Returns duration in milliseconds (integer division, `0` when invalid).
pub function ClipboardAudio.duration_ms(self: ClipboardAudio) -> int
    if self.audio_valid() == 0
        return 0
    end
    return self.frames() * 1000 / self.sample_rate
end

## Returns one-line summary (e.g. `"8000Hz mono 8-bit, 12 frames"`).
pub function ClipboardAudio.audio_summary(self: ClipboardAudio) -> string
    let layout = "mono"
    if self.channels == 2
        layout = "stereo"
    elif self.channels > 2
        layout = "{self.channels}ch"
    end
    return "{self.sample_rate}Hz {layout} {self.bits}-bit, {self.frames()} frames"
end

## Returns detailed description including duration and validity.
pub function ClipboardAudio.audio_describe(self: ClipboardAudio) -> string
    let flag = "invalid"
    if self.audio_valid() == 1
        flag = "valid"
    end
    return "[Audio] {self.audio_summary()}, duration={self.duration_ms()}ms, {flag}"
end

# ───────────────────────────────────────────────────────────────
# Struct Methods: ClipboardEntry
# ───────────────────────────────────────────────────────────────

## Returns one-line summary (`"[seq N] mime (size)"`).
pub function ClipboardEntry.entry_summary(self: ClipboardEntry) -> string
    return "[seq {self.seq}] {self.mime} ({self.size})"
end

## Returns detailed description including format code and preview.
pub function ClipboardEntry.entry_describe(self: ClipboardEntry) -> string
    return "[Entry] format={self.format}, mime={self.mime}, seq={self.seq}, size={self.size}, preview={self.preview}"
end

## Returns 1 when the entry carries a known format and non-negative size.
pub function ClipboardEntry.entry_valid(self: ClipboardEntry) -> int
    if self.size < 0 or self.seq < 0
        return 0
    end
    return 1
end

# ───────────────────────────────────────────────────────────────
# Struct Methods: ClipboardStats
# ───────────────────────────────────────────────────────────────

## Returns total read/write operations served.
pub function ClipboardStats.total_ops(self: ClipboardStats) -> int
    return self.writes + self.reads
end

## Returns one-line summary of counters, formats, and history depth.
pub function ClipboardStats.stats_summary(self: ClipboardStats) -> string
    return "[Clipboard] writes={self.writes}, reads={self.reads}, clears={self.clears}, seq={self.seq}, formats={self.formats}, history={self.history_len}"
end
